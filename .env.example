# URL del Web App de Google Apps Script (deploy: Ejecutar como YO, Acceso: Cualquiera).
# Copia este archivo a ".env" y pega tu URL real.
VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXX/exec

# Base path para GitHub Pages. Debe ser "/<nombre-del-repo>/".
# Ej: si el repo es github.com/tuusuario/FGR -> "/FGR/"
VITE_BASE=/FGR/
